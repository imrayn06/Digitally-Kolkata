{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/wp-admin(.*)",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/admin",
      "permanent": false
    }
  ]
}
